#!/usr/bin/env bash
# Pushes the current branch, opens its pull request and merges it (squash). Before the push it runs the local Codex
# review (bin/review): P0, P1 or P2 block it, and its verdict goes into the pull request body. There is no CI review
# on GitHub here; the Hermes /review comes first (AGENTS.md).
# Usage: bin/pr [--skip-review] ["title"]   (--skip-review only with the maintainer's authorization; default title:
# last commit). The base branch is the repository's default branch; BASE_BRANCH overrides it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

SKIP_REVIEW=0
if [[ "${1:-}" == "--skip-review" ]]; then SKIP_REVIEW=1; shift; fi

BASE="$(node bin/lib/local-review.mjs --print-base)"
BRANCH="$(git branch --show-current)"
[[ "$BRANCH" != "$BASE" ]] || { echo "Create a branch: git switch -c <type>/<subject>" >&2; exit 1; }
[[ -z "$(git status --porcelain)" ]] || { echo "There are uncommitted changes." >&2; exit 1; }

# The only fetch: bin/review is told not to repeat it. Explicit refspec: in a single-branch clone a fetch of the bare
# branch name only fills FETCH_HEAD and origin/<base> stays missing or stale.
git fetch --quiet origin "+refs/heads/$BASE:refs/remotes/origin/$BASE"
REVIEWED="$(git rev-parse HEAD)"
SUMMARY="$(mktemp)"
BODY="$(mktemp)"
trap 'rm -f "$SUMMARY" "$BODY" "$BODY.new"' EXIT
if (( SKIP_REVIEW )); then
  echo "Local review skipped (--skip-review). Record the maintainer's authorization in the PR description." >&2
  printf '## Local Codex review\n\nLocal review skipped (--skip-review). Authorization of the maintainer: (record it here).\n' > "$SUMMARY"
else
  bin/review --base "origin/$BASE" --no-fetch --summary-file "$SUMMARY"
fi
# Push exactly the reviewed commit: a commit made during the review never goes up unreviewed.
[[ "$(git rev-parse HEAD)" == "$REVIEWED" ]] || { echo "The branch changed during the review; run bin/pr again." >&2; exit 1; }

git push --quiet origin "$REVIEWED:refs/heads/$BRANCH"
# Upstream of the branch, written directly: `--set-upstream-to` needs origin/<branch> to be a tracking ref, which a
# single-branch clone (remote.origin.fetch maps only the base) does not have.
git config "branch.$BRANCH.remote" origin
git config "branch.$BRANCH.merge" "refs/heads/$BRANCH"
# Only an OPEN pull request of this branch into the base branch counts: `gh pr view <branch>` also finds an old
# merged PR when a branch name is reused, and merging that one would report success with nothing reaching the base.
PR="$(gh pr list --head "$BRANCH" --base "$BASE" --state open --json number -q '.[0].number')"
if [[ -z "$PR" ]]; then
  # Body: the commits plus the local review verdict, the verdict between markers so a later run can replace it.
  { echo "## Commits"; echo; git log --reverse --format='- %s' "origin/$BASE..$REVIEWED"; echo; } > "$BODY"
  node bin/lib/local-review.mjs --splice-summary "$BODY" "$SUMMARY" > "$BODY.new"
  mv "$BODY.new" "$BODY"
  PR="$(gh pr create --base "$BASE" --head "$BRANCH" --title "${1:-$(git log -1 --format=%s)}" --body-file "$BODY")"
  PR="${PR##*/}"
else
  # Existing PR: only the delimited review section changes; the description written by hand stays.
  [[ "$PR" =~ ^[0-9]+$ ]] || { echo "Could not read the pull request number (got '$PR')." >&2; exit 1; }
  gh pr view "$PR" --json body -q .body > "$BODY"
  node bin/lib/local-review.mjs --splice-summary "$BODY" "$SUMMARY" > "$BODY.new"
  mv "$BODY.new" "$BODY"
  gh pr edit "$PR" --body-file "$BODY"
fi
[[ "$PR" =~ ^[0-9]+$ ]] || { echo "Could not find or open the pull request (got '$PR')." >&2; exit 1; }
gh pr view "$PR" --json url -q .url
# Wait for the CI jobs of the reviewed commit and merge only when each one of them succeeded. `gh pr checks` is not a
# gate: it exits 0 when the checks that did report are cancelled, skipped or neutral, and when only some of the jobs
# have registered yet. So the check runs of $REVIEWED are read directly (gh api exits 1 on a failed call, and its
# JSON/jq output says nothing about the outcome) and every job named in REQUIRED_CHECKS must be completed with the
# conclusion success: a job that is missing or still running keeps the wait going; a job that ended in anything else
# (failure, cancelled, skipped, neutral, timed_out, ...) blocks at once. REQUIRED_CHECKS are the job names of
# .github/workflows/ci.yml (tests/test_ci_config.py keeps them equal). Waits are bounded here and portable (no
# `timeout` binary needed): CHECKS_TIMEOUT_SECONDS (default 1200) for jobs that are running, CHECKS_REGISTER_SECONDS
# (default 180) for jobs to appear after the push, CHECKS_POLL_SECONDS (default 10) between reads. A timeout blocks.
REQUIRED_CHECKS=("Build check and Node tests" "Python tests" "gitleaks")
CHECKS_POLL="${CHECKS_POLL_SECONDS:-10}"
CHECKS_DEADLINE=$(( SECONDS + ${CHECKS_TIMEOUT_SECONDS:-1200} ))
REGISTER_DEADLINE=$(( SECONDS + ${CHECKS_REGISTER_SECONDS:-180} ))
echo "Waiting for the checks of PR #$PR (commit ${REVIEWED:0:12}) ..." >&2
while :; do
  set +e
  RUNS="$(gh api "repos/{owner}/{repo}/commits/$REVIEWED/check-runs?per_page=100" --paginate \
    --jq '.check_runs[] | [.name, .status, (.conclusion // "")] | @tsv' 2>&1)"; RUNS_RC=$?
  set -e
  READ_ERROR=""
  if (( RUNS_RC != 0 )); then READ_ERROR="$RUNS"; RUNS=""; fi
  BAD=""; PENDING=""; MISSING=""
  for name in "${REQUIRED_CHECKS[@]}"; do
    seen=0
    while IFS=$'\t' read -r run_name run_status run_conclusion; do
      [[ "$run_name" == "$name" ]] || continue
      seen=1
      if [[ "$run_status" != "completed" ]]; then PENDING+="$name, "
      elif [[ "$run_conclusion" != "success" ]]; then BAD+="$name: ${run_conclusion:-no conclusion}; "
      fi
    done <<< "$RUNS"
    (( seen )) || MISSING+="$name, "
  done
  if [[ -n "$BAD" ]]; then
    echo "PR #$PR was not merged: checks failed (a required check must end in success)." >&2; echo "${BAD%; }" >&2; exit 1
  fi
  [[ -n "$PENDING$MISSING" ]] || break
  if [[ -n "$MISSING" ]] && (( SECONDS >= REGISTER_DEADLINE )); then
    if [[ -z "$RUNS" ]]; then
      echo "PR #$PR was not merged: no checks reported after ${CHECKS_REGISTER_SECONDS:-180}s (is .github/workflows/ci.yml on the branch?)." >&2
    else
      echo "PR #$PR was not merged: required checks not reported after ${CHECKS_REGISTER_SECONDS:-180}s: ${MISSING%, }." >&2
    fi
    [[ -z "$READ_ERROR" ]] || echo "Could not read the checks: $READ_ERROR" >&2
    exit 1
  fi
  if [[ -n "$PENDING" ]] && (( SECONDS >= CHECKS_DEADLINE )); then
    echo "PR #$PR was not merged: checks still pending after ${CHECKS_TIMEOUT_SECONDS:-1200}s: ${PENDING%, }." >&2; exit 1
  fi
  sleep "$CHECKS_POLL"
done
echo "Checks of PR #$PR passed." >&2
# Merge only the reviewed commit; the remote branch goes away, the local one stays until you delete it.
gh pr merge "$PR" --squash --match-head-commit "$REVIEWED"
# `gh pr merge` also exits 0 when it only queued the PR or enabled auto-merge: delete the branch only once
# GitHub reports the PR as MERGED, or the pending merge would be cancelled.
STATE="$(gh pr view "$PR" --json state -q .state)"
[[ "$STATE" == "MERGED" ]] || { echo "PR #$PR is not merged yet (state: $STATE); the branch was kept." >&2; exit 1; }
gh api -X DELETE "repos/{owner}/{repo}/git/refs/heads/$BRANCH" >/dev/null 2>&1 || true
gh pr view "$PR" --json state,mergeCommit -q '.state + " " + (.mergeCommit.oid // "")'
